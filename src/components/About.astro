---
import { site } from "../config/site.config";
const { about } = site;
---

<section id="about" class="section section--alt">
  <div class="container about">
    <img
      src={about.image}
      alt=""
      class="about__image"
      width="500"
      height="400"
      loading="lazy"
    />
    <div>
      <h2>{about.title}</h2>
      <p>{about.text}</p>
      <ul class="stats">
        {about.stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .about__image {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  p {
    color: var(--color-muted);
  }
  .stats {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    flex-wrap: wrap;
  }
  .stats strong {
    display: block;
    font-size: 2rem;
    font-family: var(--font-heading);
    color: var(--color-primary);
  }
  .stats span {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
